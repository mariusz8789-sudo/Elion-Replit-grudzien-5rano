# Genesis OS — zmienne środowiskowe (skopiuj do .env; .env jest w .gitignore)

# Klucz API Anthropic dla funkcji "Zapytaj AI" (backend).
# Bez klucza aplikacja działa w pełni, z uczciwym komunikatem przy pytaniach do AI.
ANTHROPIC_API_KEY=

# Port backendu (Replit/kontenery ustawiają PORT automatycznie)
PORT=8080

# Model AI (domyślnie claude-opus-4-8)
GENESIS_AI_MODEL=claude-opus-4-8

# Katalog statycznego buildu serwowany w produkcji
# (domyślnie packages/frontend/dist względem backendu)
# GENESIS_STATIC_DIR=

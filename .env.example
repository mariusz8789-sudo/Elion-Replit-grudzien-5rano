NODE_ENV=development
PORT=5000

# PostgreSQL (Neon serverless-compatible connection string)
DATABASE_URL=postgres://user:pass@localhost:5432/point2point

# Session
SESSION_SECRET=change_me_to_a_long_random_string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# Mapbox
MAPBOX_TOKEN=pk.xxx
VITE_MAPBOX_TOKEN=pk.xxx

# CORS (comma separated list of allowed origins in production)
ALLOWED_ORIGINS=https://your-app.onrender.com

# AI features: cargo photo recognition, chat translation (Claude/Anthropic).
# Both features are optional and degrade gracefully (503 with a clear message) if unset.
ANTHROPIC_API_KEY=

# Driver calendar sync: Google Calendar OAuth app (optional; connect UI hides itself if unset)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://your-app.onrender.com/api/calendar/google/callback

# Driver calendar sync: Microsoft/Outlook OAuth app (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://your-app.onrender.com/api/calendar/outlook/callback

# WebRTC voice/video calls: TURN relay for reliable NAT traversal in production.
# Falls back to Google's public STUN servers if unset (works on many networks, not all).
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Public Partner API: signs the short-lived JWTs issued in exchange for an API key
PARTNER_JWT_SECRET=change_me_to_a_long_random_string

# Cross-instance WebSocket broadcast fanout (chat/live-tracking/call signaling). Required
# once running more than one server instance/worker, otherwise broadcasts only reach
# sockets connected to the same process. Falls back to same-process-only if unset.
REDIS_URL=

# MoveX Road Services: AI route analysis + conversational agent (Claude/Anthropic).
# Reuses ANTHROPIC_API_KEY above; override the model per-feature if needed.
ROAD_SERVICES_MODEL=

# MoveX Road Services: external commercial provider integrations, all optional per
# category. Until a category's URL/key are set, that category falls back to the
# internal partner marketplace (real partner-listed products), never fake data.
VIGNETTE_PROVIDER_API_URL=
VIGNETTE_PROVIDER_API_KEY=
TOLL_PROVIDER_API_URL=
TOLL_PROVIDER_API_KEY=
FERRY_PROVIDER_API_URL=
FERRY_PROVIDER_API_KEY=
PARKING_PROVIDER_API_URL=
PARKING_PROVIDER_API_KEY=
FUEL_PROVIDER_API_URL=
FUEL_PROVIDER_API_KEY=
INSURANCE_PROVIDER_API_URL=
INSURANCE_PROVIDER_API_KEY=
DRIVER_SERVICE_PROVIDER_API_URL=
DRIVER_SERVICE_PROVIDER_API_KEY=

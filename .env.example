# Genesis — environment variables. Copy to .env (which is gitignored).
#
# Every variable below is optional. With none of them set the platform starts,
# serves the UI and the API, and refuses honestly wherever a key is missing.

# Anthropic API key for the AI-assisted endpoints.
# Without it the application runs in full; AI questions return an honest 503.
ANTHROPIC_API_KEY=

# Backend port. Containers and PaaS hosts usually set PORT themselves.
PORT=8080

# Rate limiting behind a reverse proxy. Set to true ONLY when the backend sits
# behind a TRUSTED proxy or load balancer — the client address is then taken
# from X-Forwarded-For. Without a trusted proxy leave it false: the header is
# trivial to forge and would let a caller walk around the limit.
GENESIS_TRUST_PROXY=false

# CORS for the public /api/v1 surface. Comma-separated allowed origins
# (e.g. https://app.example.com,https://sandbox.example.com) or '*'.
# Empty (the default) disables CORS and leaves the API same-origin only.
# An origin is echoed back only if it is on this list — never an arbitrary one.
GENESIS_CORS_ORIGINS=

# Asynchronous worker pool for RDKit. false (default) keeps the synchronous
# path untouched. true moves heavy computation onto a thread pool so the event
# loop stays responsive and health/metrics answer immediately.
ASYNC_EXECUTION=false
# Pool size (default min(4, cores-1)). Only meaningful with ASYNC_EXECUTION=true.
# GENESIS_WORKER_POOL_SIZE=

# Automatic SQLite backups. Set a directory to ENABLE periodic copies
# (VACUUM INTO — consistent and non-blocking). Empty disables them.
# Manual: npm run backup / npm run restore.
# GENESIS_BACKUP_DIR=
# GENESIS_BACKUP_INTERVAL_MS=21600000   # backup interval (default 6 h, min 60 s)
# GENESIS_BACKUP_KEEP=7                 # how many copies to retain (rotation)

# AI model.
GENESIS_AI_MODEL=claude-opus-4-8

# Grounding layer for AI answers (GROUNDING.md, docs/GROUNDING_LAYER_DESIGN.md).
# false (default) is a full pass-through; /api/ask behaves unchanged.
# true verifies every molecular claim in an answer against a real RDKit
# computation before the answer is sent to the user.
GROUNDING_ENABLED=false

# Directory of the static build served in production
# (default packages/frontend/dist, relative to the backend).
# GENESIS_STATIC_DIR=

# Stripe payments — Checkout, webhook, automatic API-key provisioning.
# Without these variables /api/billing/* returns 503 billing_not_configured and
# nothing else changes. Requires a host with egress to api.stripe.com and a
# public webhook URL; see docs/DEPLOYMENT.md. The webhook secret comes from the
# Stripe dashboard (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

# Persistent store path (SQLite via the built-in node:sqlite).
# Default packages/backend/data/genesis.db. Set ":memory:" for ephemeral
# deployments with no volume — data is lost on restart. In production point
# this at a durable volume so accounts, projects and trials survive a restart.
# GENESIS_DB_PATH=

# Genesis OS — zmienne środowiskowe (skopiuj do .env; .env jest w .gitignore)

# Klucz API Anthropic dla funkcji "Zapytaj AI" (backend).
# Bez klucza aplikacja działa w pełni, z uczciwym komunikatem przy pytaniach do AI.
ANTHROPIC_API_KEY=

# Port backendu (Replit/kontenery ustawiają PORT automatycznie)
PORT=8080

# Rate limiting za reverse-proxy (Stage 8, PART 4). Ustaw na true TYLKO gdy backend
# stoi za ZAUFANYM proxy/load-balancerem (Replit, nginx, Cloudflare) — wtedy realny
# adres klienta bierzemy z X-Forwarded-For. Bez zaufanego proxy zostaw false (nagłówek
# jest łatwy do sfałszowania i pozwoliłby omijać limit).
GENESIS_TRUST_PROXY=false

# CORS dla publicznego API /api/v1 (Genesis 2.0, M4). Lista dozwolonych origin po
# przecinku (np. https://app.twojadomena.pl,https://sandbox.twojadomena.pl) albo '*'.
# Puste (domyślnie) → CORS wyłączone, API dostępne tylko same-origin. Origin jest
# odbijany wyłącznie, jeśli jest na tej liście — nigdy dowolny.
GENESIS_CORS_ORIGINS=

# Model AI (domyślnie claude-opus-4-8)
GENESIS_AI_MODEL=claude-opus-4-8

# Grounding Layer dla odpowiedzi AI (docs/GROUNDING_LAYER_DESIGN.md).
# false (domyślnie) → pełny pass-through, zachowanie /api/ask bez zmian.
# true → każda odpowiedź AI przechodzi przez weryfikację twierdzeń molekularnych
#        względem realnych obliczeń RDKit przed wysłaniem użytkownikowi.
GROUNDING_ENABLED=false

# Katalog statycznego buildu serwowany w produkcji
# (domyślnie packages/frontend/dist względem backendu)
# GENESIS_STATIC_DIR=

# Płatności Stripe (Etap 1 — Checkout → webhook → auto-provisioning klucza API).
# Bez tych zmiennych /api/billing/* zwraca 503 billing_not_configured (bez zmian
# w reszcie aplikacji). Wymaga hosta z egresem do api.stripe.com i publicznym URL
# na webhook — patrz docs. Sekret webhooka pochodzi z Dashboardu Stripe (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

# Ścieżka pliku trwałego magazynu (SQLite, wbudowany node:sqlite).
# Domyślnie packages/backend/data/genesis.db. Ustaw ":memory:" dla wdrożeń
# efemerycznych bez woluminu (dane znikają po restarcie). Na produkcji wskaż
# ścieżkę na trwałym woluminie, aby konta, projekty i Serie Prób przetrwały restart.
# GENESIS_DB_PATH=

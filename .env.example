# Genesis OS — pełna lista zmiennych środowiskowych, które kod NAPRAWDĘ czyta.
#
# Skopiuj do .env (.env jest w .gitignore i nigdy nie był w historii repo —
# zweryfikowane, patrz docs/P0_EVIDENCE.md P0.4).
#
# ZASADA TEGO PLIKU:
#  - SEKRETY są tu ZAWSZE puste. Wartość sekretu nie trafia do repo nigdy,
#    także jako „przykład" — pusta prawa strona jest dokumentacją, że zmienna
#    istnieje, nie zaproszeniem do wpisania klucza w pliku śledzonym gitem.
#  - Zmienne NIE-sekretne mogą pokazywać swoją wartość domyślną, bo to jest
#    użyteczna informacja, a nie wyciek. Każda taka linia jest tym, co system
#    przyjmie sam, gdy jej nie ustawisz.
#
# Ta lista jest kompletna względem `git grep process.env` w packages/ i scripts/.
# Wcześniejsza wersja dokumentowała 5 z 25 zmiennych i POMIJAŁA dwie zmienne
# kredencjałowe (GENESIS_RESEARCH_API_KEY, GENESIS_INSTITUTIONAL_API_KEY) —
# operator wdrażający system nie mógł wiedzieć, jakie sekrety on w ogóle przyjmuje.

# ============================================================================
# SEKRETY — wyłącznie jako sekret hostingu. Nigdy w repo, nigdy w obrazie,
# nigdy w logu. Wszystkie trzy są OPCJONALNE: bez nich system działa i mówi
# wprost, czego nie potrafi (a nie udaje wyniku).
# ============================================================================

# Klucz API Anthropic — funkcja „Zapytaj AI" (proxy w backendzie; klucz nie
# opuszcza serwera). Bez klucza /api/ask zwraca uczciwy komunikat.
ANTHROPIC_API_KEY=

# Klucz do uwierzytelnionych źródeł badawczych (warstwa dostępu w access.mjs).
# Bez niego te źródła raportują status REQUIRES_AUTH zamiast AVAILABLE.
GENESIS_RESEARCH_API_KEY=

# Klucz do źródeł instytucjonalnych/ograniczonych (j.w., poziom RESTRICTED).
GENESIS_INSTITUTIONAL_API_KEY=

# ============================================================================
# RUNTIME I TRWAŁOŚĆ
# ============================================================================

# Port backendu (Replit/kontenery ustawiają automatycznie).
PORT=8080

# Model AI używany przez proxy.
GENESIS_AI_MODEL=claude-opus-4-8

# Ścieżka pliku SQLite. MUSI wskazywać trwały wolumen POZA drzewem aplikacji —
# domyślna ścieżka (packages/backend/data/genesis.db) leży wewnątrz drzewa i na
# wdrożeniu kontenerowym ginie przy każdym redeployu (P0.2). Obraz produkcyjny
# ustawia /data/genesis.db i deklaruje VOLUME ["/data"].
# Wartość ":memory:" = wdrożenie świadomie efemeryczne (dane znikają z restartem).
# Serwer raportuje tę ocenę w logu startowym i w /api/health jako `db.durability`.
GENESIS_DB_PATH=

# Katalog na snapshoty bazy (scripts/db-backup.mjs). Domyślnie <katalog bazy>/backups.
GENESIS_BACKUP_DIR=

# Ścieżka pliku JSON snapshotu Evidence Ledger (D-130): proposals, published records,
# łańcuch hashy. Domyślnie <katalog GENESIS_DB_PATH>/evidence-ledger.json; przy
# GENESIS_DB_PATH=:memory: domyślnie także :memory: (ledger efemeryczny). Wartość
# ":memory:" wymusza pamięć niezależnie od bazy. Status w logu startowym i /api/health
# jako `knowledgeLedger`.
GENESIS_LEDGER_PATH=

# Katalog statycznego buildu PWA serwowanego w produkcji.
GENESIS_STATIC_DIR=

# Katalog plików knowledge/*.md (grounding dla /api/ask).
GENESIS_KNOWLEDGE_DIR=

# ============================================================================
# TOŻSAMOŚĆ WYDANIA — wstrzykiwana przy budowie obrazu, nie ustawiana ręcznie.
# Bez nich /api/health nie potrafi powiedzieć, KTÓRY kod stoi na produkcji
# (pole commitSource raportuje wtedy 'unavailable' zamiast zmyślać hash).
#   docker build --build-arg GENESIS_COMMIT=$(git rev-parse HEAD) \
#                --build-arg GENESIS_BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ) .
# ============================================================================
GENESIS_COMMIT=
GENESIS_BUILT_AT=

# Railway supplies this automatically for GitHub-triggered deployments. Genesis
# reads it only as the release identity fallback when GENESIS_COMMIT is absent;
# operators must not invent or manually override it.
RAILWAY_GIT_COMMIT_SHA=

# Opcje procesu Node dziedziczone przez narzędzia podrzędne. Backend dopisuje
# `--use-system-ca` wyłącznie do subprocessu `npm audit` na Windows, zachowując
# pozostałe ustawione opcje i pełną walidację TLS.
NODE_OPTIONS=

# ============================================================================
# SILNIKI NAUKOWE — ścieżki do interpreterów/danych. Nieustawione = dany silnik
# raportuje BLOCKED_BY_RUNTIME w /api/health i w toolchainie, zamiast udawać wynik.
# ============================================================================
GENESIS_PYTHON=
GENESIS_RDKIT_PYTHON=
GENESIS_ADMET_PYTHON=
GENESIS_DOCKING_PYTHON=
GENESIS_PYSCF_PYTHON=
GENESIS_OPENMM_PYTHON=
GENESIS_BIOPYTHON_PYTHON=
GENESIS_MEEP_PYTHON=

# Wyłącznie dla osobnych, prywatnych usług workerów Railway. Każdy obraz
# ustawia jedną stałą grupę: chem-light, structural albo admet. Główny serwis
# web/API pozostawia tę zmienną pustą.
GENESIS_WORKER_GROUP=

# Prywatne workery naukowe Railway (główny serwis web/API). Ustaw URL grupy,
# aby jej zdolności wykonywały się zdalnie; puste = wykonanie lokalne jak dotąd.
# Dozwolone: https://… albo http:// wyłącznie dla *.railway.internal / loopback.
GENESIS_CHEM_LIGHT_WORKER_URL=
GENESIS_STRUCTURAL_WORKER_URL=
GENESIS_ADMET_WORKER_URL=
# Wspólny sekret (≥ 32 znaki) — ustaw identycznie w serwisie web/API i w każdym
# workerze. Nigdy nie commituj wartości.
GENESIS_SCIENTIFIC_WORKER_TOKEN=

# Trwały katalog wyników docking/QM; brak wartości oznacza jawnie EPHEMERAL_TEMP.
GENESIS_ARTIFACT_DIR=
# Katalog dopuszczonych wejściowych struktur OpenMM (np. zweryfikowany 1VII.pdb).
GENESIS_OPENMM_DATA_DIR=

# Katalogi danych/artefaktów przypiętych zbiorów referencyjnych.
GENESIS_CERN_OPEN_DATA_DIR=
GENESIS_NIST_FIXTURE_DIR=
GENESIS_KEPLER_FIXTURE_DIR=
GENESIS_QE4_FIXTURE_DIR=
GENESIS_CMS_ZMUMU_FIXTURE_DIR=
GENESIS_B1_FIXTURE_DIR=
GENESIS_A1_FIXTURE_DIR=
GENESIS_A2_FIXTURE_DIR=
# D-110 — test-only redirects for scripts/ingest-a2-trial-evidence.mjs, so its
# end-to-end test runs against a throwaway sandbox copy instead of the real
# A2/A1 pins. Leave both unset in every real run; the script then resolves the
# real repository paths.
GENESIS_A2_DIR=
GENESIS_A1_META_PATH=
GENESIS_A3_FIXTURE_DIR=
GENESIS_E2E01_FIXTURE_DIR=

# Ścieżka do pliku zamrożonych progów predykcyjnych (D-069 Option A: MODEL_ESTIMATE
# predictions are frozen hard filters, never objectives). Domyślnie
# campaign/frozen-prediction-thresholds.json — bez pliku kampania ODMAWIA gatingu
# kandydatów na niezamrożonych szacunkach modelu (RULE_NOT_FROZEN), nie ma "no filter".
GENESIS_PREDICTION_THRESHOLDS=

# Ścieżka do pliku zamrożonej bramki walidacyjnej GLP-1R QSAR (D-077: MIN_TRAIN/
# MIN_TEST/MAX_MAE/MIN_R2 zapieczętowane PRZED pobraniem jakichkolwiek danych).
# Domyślnie campaign/glp1r-validation-gate.json obok modułu. Loader przelicza
# ruleFingerprint z samego obiektu `gate` i ODMAWIA (GATE_TAMPERED), jeśli ktoś
# edytował próg bez ponownego zamrożenia — zmiana progu wymaga nowego D-entry.
GENESIS_GLP1R_GATE=

# scripts/fetch-b1-defra-aurn-fixture.mjs: kod stacji DEFRA AURN i rok do pobrania
# (np. MY1/2023) — parametry macierzy CI joba b1-defra-aurn-pin-narrow, nie sekrety.
SITE=
YEAR=

# ============================================================================
# TRYBY TESTOWE I E2E — nieustawione w produkcji.
# ============================================================================

# Zezwolenie na zapis realnych artefaktów Evidence przez testy/skrypty.
GENESIS_WRITE_REAL_EVIDENCE=

# Wymuszenie realnego backendu w testach frontendu zamiast atrapy.
GENESIS_REAL_BACKEND=

# Port dla lokalnego static servera w scripts/gov-drug-campaign-browser-e2e.mjs.
GDD_PORT=

# Chromium dla smoke E2E (scripts/smoke-e2e.mjs, inquiry-e2e.mjs).
CHROME=
GENESIS_CHROMIUM_PATH=
PLAYWRIGHT_BROWSERS_PATH=
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
PW_CHROMIUM=

# Adres bazowy dla smoke/E2E (domyślnie http://127.0.0.1:8080).
E2E_BASE=
SMOKE_BASE=
# scripts/city-hud-e2e.mjs: adres bazowy (domyślnie http://localhost:8080). Nie sekret.
GENESIS_BASE=

# Binarka ffmpeg dla scripts/genesis-investor-demo-capture.mjs (przycięcie nagrania i
# kodowanie demo.mp4). Domyślnie `ffmpeg` z PATH; bez ffmpeg skrypt zostawia demo.webm.
FFMPEG=
# Ścieżka do ZAMROŻONEJ bramki walidacyjnej GIPR (D-081), drugiej osi mechanizmu
# tirzepatydu. Domyślnie campaign/gipr-validation-gate.json obok modułu. Ten sam
# fail-closed loader co dla GLP-1R (validationGate.mjs): ruleFingerprint jest
# przeliczany z samego obiektu `gate`, a edycja progu bez ponownego zamrożenia
# daje GATE_TAMPERED. Progi są IDENTYCZNE jak w bramce GLP-1R — rzadsze dane
# publiczne to powód, dla którego bramkę trudno przejść, a nie powód, by ją obniżyć.
GENESIS_GIPR_GATE=

# --- Knowledge ingestion (Science Chat `/ingest <url>`, packages/backend/src/knowledgeApi.mjs) ---
# Official platform APIs only; without a key the adapter answers REQUIRES_OFFICIAL_API and fetches
# nothing. Plain-web URLs are fetched only for domains marked VERIFIED in the source-policy registry.
# Secrets stay empty here — set them in .env / the secret manager, never in a tracked file.
YOUTUBE_API_KEY=
X_API_KEY=
FACEBOOK_API_KEY=

# scripts/validate-e2e.mjs: set to 1 to request the port check against active 5000/8080 services
# (the validator itself starts no service). Not a secret.
GENESIS_VALIDATE_PORTS=

# --- Hybrid Quantum Computing Bridge (Science Chat `/quantum …`, packages/backend/src/quantumApi.mjs) ---
# A real cloud QPU is used ONLY when BOTH are set (endpoint + bearer key); otherwise every job runs on
# the local statevector simulator and is labelled MODEL_ESTIMATE / fallbackReason=NO_CLOUD_PROVIDER.
# The key is never logged and never returned by /api/quantum/status. Secrets stay empty here.
QPU_API_URL=
QPU_API_KEY=

# Playwright / e2e: adres serwera Genesis, na który celują spec-e (packages/ui/**/*.e2e.spec.ts)
# i scripts/capture-matrix-screenshots.mjs. Puste = http://127.0.0.1:8080 (serwer produkcyjny uruchomiony lokalnie).
GENESIS_BASE_URL=

# Read-only post-deploy verifier (`npm run staging:verify`). Set only in the
# trusted operator shell; never consumed by the deployed application process.
GENESIS_STAGING_BASE_URL=

# scripts/temporal-cinematic-e2e-capture.mjs: capture-only overrides, not simulation state.
# Weather preset passed to the canonical route (default CLEAR).
TEMPORAL_WEATHER=
# Number of captured frames (default 6) and playback duration in seconds (default 3).
TEMPORAL_FRAME_COUNT=
TEMPORAL_DURATION_SECONDS=

# Canonical temporal/cinematic browser capture. These values control only the
# local evidence runner; they do not alter the simulation or production state.
# BASE_URL is the already-running Genesis preview used by the capture script.
BASE_URL=
# Optional explicit Chromium/Edge executable. Empty lets the runner use its
# normal verified-browser discovery path.
CHROMIUM_PATH=
# Output aspect: 16:9, 9:16 or 1:1. Empty uses the script default.
TEMPORAL_ASPECT=
# Optional artifact output directory for captured frames, MP4 and manifest.
TEMPORAL_OUT_DIR=
# Optional JSON array describing the bounded scenes to capture.
TEMPORAL_SCENES_JSON=

# scripts/genesis-vision-worlds-e2e.mjs: optional directory for the real
# prompt-world Chromium screenshots and their manifest. Empty uses the
# repository's normal artifacts/vision-review/worlds-final location.
GENESIS_VISION_OUT=

# scripts/genesis-science-chat-integrity-e2e.mjs: optional output directory for
# Science Chat integrity evidence. Empty uses artifacts/vision-review/science-chat-integrity.
# This is a local artifact path, not a secret and not a scientific input.
GENESIS_SCIENCE_CHAT_OUT=

# Prompt-world cinematic proof. Output defaults to
# artifacts/vision-review/prompt-world-films; the default capture is 24 frames
# over 4 seconds (6 FPS). Overrides remain bounded by the runner.
GENESIS_PROMPT_FILM_OUT=
GENESIS_PROMPT_FILM_FRAMES=
GENESIS_PROMPT_FILM_DURATION=
# Comma-separated focused cases for the same runner (for example
# `underwater`); empty/`all` runs the complete visual audit.
GENESIS_PROMPT_FILM_CASES=

# Optional directory containing operator-provided, legally usable local AI-video
# checkpoints. Empty keeps local generation honestly BLOCKED_MODEL_UNAVAILABLE.
# Genesis never downloads weights automatically and never treats generated media
# as scientific Evidence.
GENESIS_LOCAL_VIDEO_MODELS_DIR=

# Test-only override used by pythonRuntime.test.mjs to prove that a
# capability-specific interpreter wins over GENESIS_PYTHON. Production code
# does not read this name, but the repository-wide environment contract also
# covers test processes so drift remains mechanically visible.
GENESIS_TEST_PYTHON=

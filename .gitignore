node_modules/
dist/
.env
*.log
*.tsbuildinfo

# Trwały magazyn backendu (SQLite) — dane runtime, nie do repo
packages/backend/data/

# heavy-engine scientific artifacts (runtime, not source)
_dock*/
*.pdbqt

# Delivery archive and local Chromium capture helpers are generated outside the source review path.
artifacts/*.zip
artifacts/*.mjs
# GOV-DRUG-DISCOVERY-E2E-01 demo package (video + rendered report): regenerated on demand by
# scripts/gov-drug-discovery-e2e-demo-capture.mjs, not source.
artifacts/gov-drug-discovery-e2e-demo/
# Investor demo capture (video), regenerated by scripts/genesis-investor-demo-capture.mjs
artifacts/genesis-investor-demo/
# Guide film capture (video), regenerated by scripts/genesis-guide-film-capture.mjs
artifacts/genesis-guide-film/

# Python bytecode from compute workers (packages/backend/src/compute/*.py)
__pycache__/
*.pyc

# Voice guide recordings are generated (npm run voice:lines + scripts/genesis_tts.py), never committed.
packages/frontend/public/audio/*.mp3
packages/frontend/public/audio/manifest.json
packages/frontend/public/audio/lines.json

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genesis:documentation:research-run-envelope:1",
  "title": "ResearchRun reference export projection",
  "description": "Export projection over existing Genesis records. Shape validation alone does not resolve references, verify hashes, establish rights or approve delivery; packages/backend/src/researchRunEvidencePack.mjs builds RESOLVED_EXPORT packs and its verifier recomputes their hashes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "research-run-envelope@1"
    },
    "researchRunContract": {
      "const": "research-run@1"
    },
    "recordMode": {
      "enum": [
        "SYNTHETIC_EXAMPLE",
        "RESOLVED_EXPORT"
      ]
    },
    "domain": {
      "const": "genesis.research-run"
    },
    "researchRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "producerCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "stateChainRef": {
      "const": "agent_run_steps"
    },
    "eventRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/eventRef"
      }
    },
    "experimentRecordRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/experimentRef"
      }
    },
    "executionRecordRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/executionRef"
      }
    },
    "scienceRunRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scienceRunRef"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "replayRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/replayRef"
      }
    },
    "sourceArtifactRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactId"
      }
    },
    "reportArtifactRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactId"
      }
    },
    "licenceDecisionArtifactRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactId"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceResolution": {
          "enum": [
            "UNVERIFIED",
            "MATCH",
            "FAILED"
          ]
        },
        "integrity": {
          "enum": [
            "UNVERIFIED",
            "VALID_INTEGRITY_ONLY",
            "INVALID"
          ]
        },
        "completeness": {
          "enum": [
            "INCOMPLETE",
            "COMPLETE"
          ]
        },
        "delivery": {
          "enum": [
            "NOT_EVALUATED",
            "BLOCKED",
            "ELIGIBLE"
          ]
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "referenceResolution",
        "integrity",
        "completeness",
        "delivery",
        "missing"
      ]
    },
    "experiments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "required": [
    "contract",
    "researchRunContract",
    "recordMode",
    "domain",
    "researchRunId",
    "projectId",
    "producerCommit",
    "stateChainRef",
    "eventRefs",
    "experimentRecordRefs",
    "executionRecordRefs",
    "scienceRunRefs",
    "evidenceRefs",
    "replayRefs",
    "sourceArtifactRefs",
    "reportArtifactRefs",
    "licenceDecisionArtifactRefs",
    "verification"
  ],
  "$defs": {
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "PROBLEM_FORMALIZED",
            "KNOWLEDGE_SNAPSHOT",
            "HYPOTHESES_GENERATED",
            "PREDICTIONS_FROZEN",
            "EXPERIMENT_HANDOFF",
            "EVIDENCE_UPDATE",
            "SELF_FALSIFICATION",
            "SURPRISE_DETECTED",
            "NEXT_EXPERIMENT",
            "RESEARCH_STEERING",
            "RUN_CONTROLLED",
            "TERMINAL",
            "ARTIFACT_PERSISTED",
            "GENERATED_ANALYSIS_PROPOSED",
            "GENERATED_ANALYSIS_EXECUTED",
            "GENERATED_ANALYSIS_REPLAYED"
          ]
        },
        "payloadFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}$"
        },
        "transitionFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}$"
        }
      },
      "required": [
        "agentRunId",
        "seq",
        "type"
      ]
    },
    "executionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "EXPERIMENT_HANDOFF"
        }
      },
      "required": [
        "agentRunId",
        "seq",
        "type"
      ]
    },
    "experimentRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "PREREGISTRATION",
            "SESSION"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "scienceRunRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "id"
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "proposalId"
      ]
    },
    "replayRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scienceRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "verificationId",
        "scienceRunId"
      ]
    },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact:[a-f0-9]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "embeddedEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "seq",
        "payload"
      ]
    },
    "replayRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scienceRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "verdict": {
          "enum": [
            "MATCH",
            "DRIFT",
            "ENGINE_VERSION_CHANGED",
            "BLOCKED_BY_RUNTIME",
            "REPLAY_UNSUPPORTED"
          ]
        },
        "originalOutputHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "replayOutputHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "replayEngineVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "verificationId",
        "scienceRunId",
        "verdict",
        "originalOutputHash",
        "replayOutputHash",
        "replayEngineVersion"
      ]
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experimentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "hypothesisId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scienceRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "PREDICTIONS_FROZEN": {
              "allOf": [
                {
                  "$ref": "#/$defs/embeddedEvent"
                },
                {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "required": [
                        "experimentId",
                        "protocolId",
                        "preregistrationRecordId",
                        "preregistrationFingerprint",
                        "predictionFingerprint",
                        "input",
                        "inputHash",
                        "criteria"
                      ],
                      "properties": {
                        "preregistrationFingerprint": {
                          "$ref": "#/$defs/sha256Hex"
                        },
                        "predictionFingerprint": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{8}$"
                        },
                        "inputHash": {
                          "$ref": "#/$defs/sha256Hex"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "EXPERIMENT_HANDOFF": {
              "allOf": [
                {
                  "$ref": "#/$defs/embeddedEvent"
                },
                {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "required": [
                        "recordVersion",
                        "researchRunId",
                        "experimentId",
                        "engine",
                        "environment",
                        "input",
                        "inputHash",
                        "status",
                        "output",
                        "outputHash"
                      ],
                      "properties": {
                        "recordVersion": {
                          "const": "research-run-execution@1"
                        },
                        "inputHash": {
                          "$ref": "#/$defs/sha256Hex"
                        },
                        "outputHash": {
                          "$ref": "#/$defs/sha256Hex"
                        },
                        "engine": {
                          "type": "object",
                          "required": [
                            "engineId"
                          ]
                        },
                        "environment": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "SELF_FALSIFICATION": {
              "$ref": "#/$defs/embeddedEvent"
            },
            "EVIDENCE_UPDATE": {
              "$ref": "#/$defs/embeddedEvent"
            },
            "NEXT_EXPERIMENT": {
              "$ref": "#/$defs/embeddedEvent"
            },
            "ARTIFACT_PERSISTED": {
              "$ref": "#/$defs/embeddedEvent"
            }
          },
          "required": [
            "PREDICTIONS_FROZEN",
            "EXPERIMENT_HANDOFF",
            "SELF_FALSIFICATION",
            "EVIDENCE_UPDATE",
            "NEXT_EXPERIMENT"
          ]
        },
        "replays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/replayRecord"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engineId": {
              "type": "string",
              "minLength": 1
            },
            "engineVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "executionStatus": {
              "type": "string",
              "minLength": 1
            },
            "inputHash": {
              "$ref": "#/$defs/sha256Hex"
            },
            "outputHash": {
              "$ref": "#/$defs/sha256Hex"
            },
            "preregistrationFingerprint": {
              "$ref": "#/$defs/sha256Hex"
            },
            "predictionFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}$"
            },
            "protocolVerdict": {
              "enum": [
                "SUPPORTED_WITHIN_PROTOCOL",
                "FALSIFIED_WITHIN_PROTOCOL",
                "INCONCLUSIVE"
              ]
            },
            "replayVerdict": {
              "enum": [
                "MATCH",
                "DRIFT",
                "ENGINE_VERSION_CHANGED",
                "BLOCKED_BY_RUNTIME",
                "REPLAY_UNSUPPORTED",
                "NOT_APPLICABLE",
                null
              ]
            },
            "artifactId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/artifactId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "engineId",
            "engineVersion",
            "executionStatus",
            "inputHash",
            "outputHash",
            "preregistrationFingerprint",
            "predictionFingerprint",
            "protocolVerdict",
            "replayVerdict",
            "artifactId"
          ]
        }
      },
      "required": [
        "experimentId",
        "hypothesisId",
        "scienceRunId",
        "events",
        "replays",
        "summary"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256(canonical-json)"
        },
        "stateChainHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}$"
        },
        "stateChainLength": {
          "type": "integer",
          "minimum": 0
        },
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "experimentId": {
                "type": "string",
                "minLength": 1
              },
              "sections": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "parameters": {
                    "$ref": "#/$defs/sha256Hex"
                  },
                  "data": {
                    "$ref": "#/$defs/sha256Hex"
                  },
                  "engine": {
                    "$ref": "#/$defs/sha256Hex"
                  },
                  "environment": {
                    "$ref": "#/$defs/sha256Hex"
                  },
                  "analysis": {
                    "$ref": "#/$defs/sha256Hex"
                  },
                  "artifact": {
                    "$ref": "#/$defs/sha256Hex"
                  },
                  "provenance": {
                    "$ref": "#/$defs/sha256Hex"
                  }
                },
                "required": [
                  "parameters",
                  "data",
                  "engine",
                  "environment",
                  "analysis",
                  "artifact",
                  "provenance"
                ]
              }
            },
            "required": [
              "experimentId",
              "sections"
            ]
          }
        },
        "packHash": {
          "$ref": "#/$defs/sha256Hex"
        }
      },
      "required": [
        "algorithm",
        "stateChainHead",
        "stateChainLength",
        "experiments",
        "packHash"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recordMode": {
            "const": "SYNTHETIC_EXAMPLE"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "referenceResolution": {
                "const": "UNVERIFIED"
              },
              "integrity": {
                "const": "UNVERIFIED"
              },
              "delivery": {
                "const": "NOT_EVALUATED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "delivery": {
                "const": "ELIGIBLE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "recordMode": {
            "const": "RESOLVED_EXPORT"
          },
          "verification": {
            "properties": {
              "referenceResolution": {
                "const": "MATCH"
              },
              "integrity": {
                "const": "VALID_INTEGRITY_ONLY"
              },
              "completeness": {
                "const": "COMPLETE"
              },
              "missing": {
                "maxItems": 0
              }
            }
          },
          "eventRefs": {
            "minItems": 1
          },
          "experimentRecordRefs": {
            "minItems": 2
          },
          "executionRecordRefs": {
            "minItems": 1
          },
          "scienceRunRefs": {
            "minItems": 1
          },
          "evidenceRefs": {
            "minItems": 1
          },
          "replayRefs": {
            "minItems": 1
          },
          "reportArtifactRefs": {
            "minItems": 1
          },
          "licenceDecisionArtifactRefs": {
            "minItems": 1
          },
          "producerCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "completeness": {
                "const": "COMPLETE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "missing": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordMode": {
            "const": "RESOLVED_EXPORT"
          }
        }
      },
      "then": {
        "required": [
          "experiments",
          "integrity"
        ],
        "properties": {
          "experiments": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

{
  "name": "genesis-os-monorepo",
  "version": "1.0.0",
  "description": "Genesis OS — mobilna platforma do eksploracji fizyki, kosmologii i nauki poprzez interaktywne symulacje oraz AI.",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace=packages/frontend",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "build": "npm run build --workspace=packages/frontend",
    "test": "npm run test --workspace=packages/reasoning && npm run test --workspace=packages/frontend && npm run test --workspace=packages/backend && npm run test:isolated --workspace=packages/backend",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,mjs,css}\" \"*.md\" \"knowledge/*.md\"",
    "preview": "npm run preview --workspace=packages/frontend",
    "backup": "node scripts/backup-db.mjs",
    "restore": "node scripts/restore-db.mjs",
    "fetch-real-data": "node scripts/fetch-real-data.mjs",
    "campaign:demo": "node scripts/campaign-demo.mjs",
    "smoke:desktop": "node scripts/smoke-e2e.mjs desktop",
    "smoke:mobile": "node scripts/smoke-e2e.mjs mobile",
    "compute:bundle": "esbuild packages/frontend/src/core/compute/serverEntry.ts --bundle --format=esm --platform=node --target=node22 --legal-comments=none --outfile=packages/backend/src/compute/core.bundle.mjs",
    "compute:bundle:check": "node scripts/check-compute-bundle.mjs",
    "campaign:validate": "node scripts/validation-campaign.mjs",
    "benchmark": "node scripts/benchmark-suite.mjs",
    "citations:worklist": "node scripts/citation-worklist.mjs",
    "citations:verify": "node scripts/verify-citations.mjs",
    "citations:brief": "node scripts/citation-brief.mjs",
    "benchmark:cognitive": "node scripts/cognitive-benchmark.mjs",
    "trial:discovery": "node scripts/genesis-discovery-trial.mjs",
    "campaign:zefir": "node scripts/zefir-discovery-campaign.mjs"
  },
  "keywords": [
    "genesis-os",
    "physics",
    "simulation",
    "education",
    "ai"
  ],
  "license": "UNLICENSED",
  "workspaces": [
    "packages/reasoning",
    "packages/frontend",
    "packages/backend"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.63.0"
  }
}

# PROPOSAL ONLY — NOT BUILT, NOT TESTED, NOT WIRED INTO ANY BUILD OR CI.
#
# Real PyMeep (the MIT electromagnetic FDTD engine that packages/backend/src/
# compute/meepAdapter.mjs and meep_worker.py expect) is distributed only via
# the conda-forge channel, with a native dependency chain (HDF5, MPICH/
# OpenMPI, harminv, libctl, guile, swig, GSL) that has no pip/PyPI equivalent.
# The PyPI package literally named "meep" (verified in this sandbox: v1.0.6)
# is an unrelated release-automation tool and must NEVER be installed here —
# it would satisfy `import meep` without providing any FDTD capability, which
# is exactly the kind of silent-fake result this repository's adapters are
# built to refuse.
#
# This sandbox has no conda/mamba/micromamba and no reachable Docker daemon
# (`docker version` shows client-only; /var/run/docker.sock is absent), so
# this Dockerfile could not be built or its reference case verified from here.
# It is committed as a documented, best-effort starting point for whoever next
# has a Docker-capable Linux host: Codex, CI, or a human operator. Until it is
# actually built AND meep_worker.py's reference case passes inside it, PyMeep
# stays classified GENUINE_EXTERNAL_BLOCKER / BLOCKED_RUNTIME — never READY.
#
# Rename to `Dockerfile` only after a real build + reference-case pass.

FROM condaforge/miniforge3:latest AS runtime
WORKDIR /app

# mpi_mpich build avoids also needing an MPI runtime choice at the OS level;
# pin an exact build once one has actually been built and tested here.
RUN conda install -y -c conda-forge pymeep=*=mpi_mpich_* nodejs=22 \
    && conda clean -afy

COPY package.json package-lock.json ./
COPY packages/backend/package.json packages/backend/
RUN npm ci --omit=dev --workspace=packages/backend && npm cache clean --force

COPY packages/backend/src packages/backend/src
ENV GENESIS_MEEP_PYTHON=/opt/conda/bin/python
ENV GENESIS_WORKER_GROUP=pymeep
RUN mkdir -p /tmp/genesis-worker \
    && useradd --system --create-home --shell /usr/sbin/nologin genesis \
    && chown -R genesis:genesis /tmp/genesis-worker /app
ENV TMPDIR=/tmp/genesis-worker

USER genesis
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8090)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "packages/backend/src/compute/workerEntrypoint.mjs"]
